import 'MagicScript'
import 'MagicScript' as t1
import MagicScript as t2
import RuntimeContext
import 'java.text.*'
import java.io.*;
return
    t1 == MagicScript
    && t2 == t1
    && DateFormat.LONG == 1
    && File::string == 'class java.io.File'
    && RuntimeContext::string == 'class RuntimeContext'